<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_dark" />
            <corners android:radius="16dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_disabled" />
            <corners android:radius="16dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="16dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>
</selector>

